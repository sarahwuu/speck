{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/entries/**",
              "components/feedback/**",
              "components/forms/**",
              "components/foundation/**",
              "components/navigation/**",
              "slides/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|PT Serif|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Figtree, PT Serif, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|scrolled|onBack|onMore|assetBase|statusInset|style|key|ref|className|style|children)$/]",
        "message": "<AppBar> doesn't accept that prop. Declared props: variant, title, scrolled, onBack, onMore, assetBase, statusInset, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:feed|detail)$/]",
        "message": "<AppBar> variant must be one of 'feed' | 'detail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|lead|children|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, lead, children, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|error)$/]",
        "message": "<Banner> tone must be one of 'neutral' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|size|disabled|loading|loadingLabel|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: level, size, disabled, loading, loadingLabel, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:primary|secondary|tertiary|destructive)$/]",
        "message": "<Button> level must be one of 'primary' | 'secondary' | 'tertiary' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:medium|small)$/]",
        "message": "<Button> size must be one of 'medium' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptureField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|error|autoFocus|rows|style|key|ref|className|style|children)$/]",
        "message": "<CaptureField> doesn't accept that prop. Declared props: value, onChange, placeholder, error, autoFocus, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|size|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, children, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|small)$/]",
        "message": "<EmptyState> size must be one of 'large' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|timestamp|quote|source|duration|screenshotLabel|note|onClick|onPlay|style|key|ref|className|style|children)$/]",
        "message": "<EntryCard> doesn't accept that prop. Declared props: type, timestamp, quote, source, duration, screenshotLabel, note, onClick, onPlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntryCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|screenshot|audio)$/]",
        "message": "<EntryCard> type must be one of 'text' | 'screenshot' | 'audio'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|disabled|onClick|size|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, disabled, onClick, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:back|close|more|play|search)$/]",
        "message": "<IconButton> name must be one of 'back' | 'close' | 'more' | 'play' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, size, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inline|contained)$/]",
        "message": "<Logo> variant must be one of 'inline' | 'contained'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper)$/]",
        "message": "<Logo> tone must be one of 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickCaptureButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|label|fixed|markSrc|style|key|ref|className|style|children)$/]",
        "message": "<QuickCaptureButton> doesn't accept that prop. Declared props: onClick, label, fixed, markSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|onClear|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, onClear, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|visible|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, visible, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
